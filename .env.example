# Google Sheets API key (for public spreadsheet read).
# Create in Google Cloud Console: enable Sheets API, create API key.
GOOGLE_SHEETS_API_KEY=your_api_key

# Telegram: create bot via @BotFather, then get your chat_id from getUpdates.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Calendar sync (optional; leave CALENDAR_ID empty to disable).
# CALENDAR_ID is the dedicated calendar this script fully manages — it deletes
# every event on it for a day before reinserting. Never use a primary calendar.
# Settings and sharing -> Integrate calendar -> Calendar ID.
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Service account JSON key, minified onto one line. Share the calendar with the
# key's client_email ("Make changes to events") before running.
#   python3 -c "import json,sys;print(json.dumps(json.load(open(sys.argv[1])),separators=(',',':')))" key.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: course year (sheet tab prefix, e.g. "4" -> " 4к 17.08-22.08.26")
# and group code as it appears in the sheet header.
# COURSE=4
# GROUP=ЛБ2F301ДОН23

# Optional: override spreadsheet IDs
# SPREADSHEET_ID=1n3k33vhPE5hlYANR8hOTtw2zKrSjgZuJLlNGa_7mw8s
# RESOURCES_SPREADSHEET_ID=1eSHyaPKkPkJrVk7lcFLFWwlRIYrwcaU8m0oz-TsChNg

# Optional: time zone the lesson times are in (default Europe/Kyiv).
# TIME_ZONE=Europe/Kyiv
